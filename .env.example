# Oeffentliche Frontend-Konfiguration fuer den AI Portfolio Assistenten.
# VITE_*-Werte landen im Browser-Bundle: hier NIEMALS Secrets eintragen
# (keine Worker-internen Header, keine API-Keys, keine Tokens).

# Voller Endpoint des Cloudflare Workers, z. B. https://<worker>.workers.dev/api/v1/chat
VITE_RAG_API_URL=

# Oeffentlicher Cloudflare-Turnstile-Site-Key
VITE_TURNSTILE_SITE_KEY=
